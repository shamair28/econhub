{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calm-thunder-4615",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  // Only /api/* runs the Worker (worker/index.js — the "Explain this" AI endpoint);
  // every other request is served straight from the static assets as before.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // GEMINI_API_KEY is a secret set in the Cloudflare dashboard, never in this file.
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
